SERVER_API_SECRET_KEY=change-me-to-a-long-random-secret

POSTGRES_DB=cultur
POSTGRES_USER=cultur
POSTGRES_PASSWORD=change-me

TMDB_API=
TMDB_LANG=en-US
OMDB_API_KEY=

# Twitch Developer Portal → IGDB API (video games)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_LANGUAGE=en

# Stash.games profile scrape — collection slugs are per-account; override for your user
# STASH_COLLECTION_PATHS=[{"key":"prioridades","path":"collections/prioridade-enxns"},{"key":"abandonados","path":"collections/abandonados-fhbry"}]

# IGDB industry events cache (seconds between IGDB syncs)
STASH_EVENTS_CACHE_TTL_SECONDS=21600
STASH_EVENTS_SYNC_PAGE_SIZE=50
STASH_EVENTS_SYNC_MAX_PAGES=5

# Hardcover — https://hardcover.app/account/api (Bookmory import by ISBN / title)
HARDCOVER_API_TOKEN=

# Book catalog: hardcover (default) | porbase | openlibrary — legacy multi-source order
# BOOK_CATALOG_PRIMARY_SOURCE=hardcover

# Browse/search sources query: hardcover | openlibrary | porbase | all
# (app sends this when user picks a catalog in book search)

# PORBASE/BNP — Portuguese ISBN lookup (no key; optional URL override)
# PORBASE_ISBN_URL_TEMPLATE=http://urn.porbase.org/isbn/dc/xml?id={isbn}

# BoardGameGeek XML API2 — register at https://boardgamegeek.com/applications
BGG_API_TOKEN=
BGG_MIN_REQUEST_INTERVAL_SECONDS=2
BGG_HOT_CACHE_TTL_SECONDS=3600

# MusicBrainz — albums catalog (required; no API key, contact email/URL mandatory)
MUSICBRAINZ_APP_NAME=Cultur
MUSICBRAINZ_CONTACT=you@example.com
# MUSICBRAINZ_MIN_REQUEST_INTERVAL_SECONDS=1.1

# Last.fm home shelf tag (tag.getTopAlbums), default rock
# LASTFM_HOME_TAG=rock

# Fanart.tv — artist photos (uses artist MBID from Last.fm when available)
FANART_API_KEY=
# FANART_CLIENT_KEY=

# Last.fm — album search fallback (https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# Discogs — deprecated, remove after MUSICBRAINZ_MIGRATION.md phase 7
# DISCOGS_API_KEY=
# DISCOGS_API_SECRET=

# Musicboard — custom list slugs; must be a single line (Docker .env cannot parse multi-line JSON)
# MUSICBOARD_LIST_PATHS=[{"key":"tobuy","path":"list/need-money-to-get-them","sourceFile":"musicboardTobuy.csv"},{"key":"story","path":"list/story-songs","sourceFile":"musicboardStory.csv"}]

# Optional: path to Chromium/Chrome binary (profile scrape uses Selenium, like Stash)
# CHROME_BIN=/usr/bin/chromium