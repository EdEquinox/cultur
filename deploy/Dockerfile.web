# Flutter web → nginx (SPA). Build context: repo root (.. from deploy/).
FROM ghcr.io/cirruslabs/flutter:stable AS flutter

WORKDIR /src
COPY cultur_app/pubspec.yaml cultur_app/pubspec.lock ./
RUN flutter pub get

COPY cultur_app/ ./

ARG CULTUR_DEFAULT_API_URL=
ARG CULTUR_ANDROID_APK_URL=
RUN set -eux; \
    build_args="--release"; \
    if [ -n "${CULTUR_DEFAULT_API_URL}" ]; then \
      build_args="$build_args --dart-define=CULTUR_DEFAULT_API_URL=${CULTUR_DEFAULT_API_URL}"; \
    fi; \
    if [ -n "${CULTUR_ANDROID_APK_URL}" ]; then \
      build_args="$build_args --dart-define=CULTUR_ANDROID_APK_URL=${CULTUR_ANDROID_APK_URL}"; \
    fi; \
    flutter build web $build_args

FROM nginx:alpine
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=flutter /src/build/web /usr/share/nginx/html
