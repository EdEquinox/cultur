# Paste into Portainer → Stack → Environment variables (one KEY=value per line).
# Do NOT use "env file" mount — this stack has no env_file: directives.

# --- Required ---
POSTGRES_PASSWORD=change-me
SERVER_API_SECRET_KEY=change-me-to-a-long-random-secret
CULTUR_DOMAIN=cultur.eqnox.com
CULTUR_API_DOMAIN=api.cultur.eqnox.com
MUSICBRAINZ_CONTACT=you@example.com

# --- Deploy / tunnel ---
# Port on the server where Caddy listens (127.0.0.1:PORT). Use 8081 if 8080 is taken.
CULTUR_HTTP_PORT=8081

# --- Images from GitHub CI (public packages on ghcr.io) ---
CULTUR_WEB_IMAGE=ghcr.io/edequinox/cultur-web:main
CULTUR_API_IMAGE=ghcr.io/edequinox/cultur-api:main

# Set as GitHub repo → Settings → Actions → Variables (used when building the image):
# CULTUR_DEFAULT_API_URL=https://api.cultur.eqnox.com
# CULTUR_ANDROID_APK_URL=https://cultur.eqnox.com/releases/cultur.apk
POSTGRES_DB=cultur
POSTGRES_USER=cultur

# --- API keys (optional but recommended) ---
TMDB_API=
TMDB_LANG=en-US
OMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
HARDCOVER_API_TOKEN=
BGG_API_TOKEN=
FANART_API_KEY=
LASTFM_API_KEY=
