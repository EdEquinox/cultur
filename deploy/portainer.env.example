# Paste into Portainer → Stack → Environment variables (one KEY=value per line).

# --- Required ---
POSTGRES_PASSWORD=change-me
SERVER_API_SECRET_KEY=change-me-to-a-long-random-secret
MUSICBRAINZ_CONTACT=you@example.com

# --- Ports on 192.168.1.230 (Cloudflare Tunnel → same ports) ---
CULTUR_WEB_PORT=8081
CULTUR_API_PORT=8787

# Cloudflare Published application routes:
#   cultur.eqnox.pt      → http://192.168.1.230:8081
#   api.cultur.eqnox.pt  → http://192.168.1.230:8787

# --- Images from GitHub CI ---
CULTUR_WEB_IMAGE=ghcr.io/edequinox/cultur-web:main
CULTUR_API_IMAGE=ghcr.io/edequinox/cultur-api:main

# GitHub Actions → Variables (web image build):
# CULTUR_DEFAULT_API_URL=https://api.cultur.eqnox.pt
# CULTUR_ANDROID_APK_URL=https://cultur.eqnox.pt/releases/cultur.apk

POSTGRES_DB=cultur
POSTGRES_USER=cultur

# --- API keys (optional) ---
TMDB_API=
TMDB_LANG=en-US
OMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
HARDCOVER_API_TOKEN=
BGG_API_TOKEN=
FANART_API_KEY=
LASTFM_API_KEY=
