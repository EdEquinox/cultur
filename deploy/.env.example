# Public hostnames (HTTPS URLs users open in the browser)
CULTUR_DOMAIN=cultur.example.com
CULTUR_API_DOMAIN=api.cultur.example.com

# Direct deploy only (Let's Encrypt on Caddy). Leave empty with Cloudflare Tunnel.
ACME_EMAIL=you@example.com

# Cloudflare Tunnel: local port for Caddy (cloudflared → http://127.0.0.1:THIS_PORT)
CULTUR_HTTP_PORT=8080

# Passed into flutter build web (optional; leave empty to configure in the app UI)
CULTUR_DEFAULT_API_URL=https://api.cultur.example.com
CULTUR_ANDROID_APK_URL=https://cultur.example.com/releases/cultur.apk
